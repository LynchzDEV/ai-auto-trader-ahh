# API Configuration
VITE_USE_MOCK=true

# =============================================================================
# SEO Configuration (for multi-site deployment)
# =============================================================================

# Your site's production URL (no trailing slash)
# Example: https://trading.example.com
VITE_SITE_URL=https://trade.lynchz.dev

# Site name displayed in titles and meta tags
VITE_SITE_NAME=Passive Income Ahh

# Site description for SEO meta tags (max ~160 characters recommended)
VITE_SITE_DESCRIPTION=AI-powered cryptocurrency trading platform using OpenRouter and Binance Futures. Automate trading with multi-AI consensus and real-time portfolio insights.

# Social media description for Open Graph and Twitter Cards (max ~160 characters)
# This appears when your site is shared on social platforms
# If not provided, falls back to VITE_SITE_DESCRIPTION
VITE_SOCIAL_DESCRIPTION=Automate your crypto trading with AI. Multi-AI debate consensus, backtesting, and real-time portfolio management.

# Twitter/X handle for Twitter Cards (include the @)
# Example: @YourHandle
VITE_TWITTER_HANDLE=

# Facebook App ID for Open Graph (optional)
VITE_FB_APP_ID=
