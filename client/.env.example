# Site description for SEO meta tags (max ~160 characters recommended)
VITE_SITE_DESCRIPTION=AI-powered cryptocurrency trading platform using OpenRouter and Binance Futures. Automate your trading with multi-AI debate consensus, backtesting, and real-time portfolio management.

# Twitter/X handle for Twitter Cards (include the @)
# Example: @YourHandle
VITE_TWITTER_HANDLE=

# Facebook App ID for Open Graph (optional)
VITE_FB_APP_ID=
