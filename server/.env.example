# =============================================
# Server Configuration
# =============================================
API_PORT=8080

# CORS allowed origins (comma-separated)
# For production: Use your actual frontend domains
# For local dev: Use http://localhost:3000
# Example: https://trade.lynchz.dev,https://folk-trade.lynchz.dev,https://demo-trade.lynchz.dev
ALLOWED_ORIGINS=http://localhost:3000

# =============================================
# Authentication
# =============================================
# Set a passkey to protect access to the trading terminal
# REQUIRED for production (BINANCE_TESTNET=false)
# Must be at least 32 characters long
# Generate with: openssl rand -base64 32
ACCESS_PASSKEY=
